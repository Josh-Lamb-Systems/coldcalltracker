# Copy to .env and adjust. Read by docker compose.

# Port the app listens on, on the host.
PORT=8090

# Login for the PocketBase dashboard at /_/ (where you add callers).
# Created or updated every time the container starts.
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-to-a-long-password

# Open sessions with no taps for this many minutes are ended automatically.
SESSION_IDLE_MINUTES=120

# Owner of the ./data folder on the host; run `id -u` and `id -g`.
PUID=1000
PGID=1000
